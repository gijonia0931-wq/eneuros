---
import ArticlePage from '../../components/ArticlePage.astro';
import { render } from 'astro:content';
import { publicados } from '../../lib';
import { TEMAS_GUIAS, CALCULADORAS } from '../../site';

export async function getStaticPaths() {
  const items = await publicados('guias');
  return items.map((entry) => {
    const tema = TEMAS_GUIAS.find((t) => t.guias.includes(entry.id));
    const relacionadas = (tema ? tema.guias.filter((id) => id !== entry.id) : [])
      .flatMap((id) => items.find((g) => g.id === id) ?? [])
      .slice(0, 3);
    const calculadora = CALCULADORAS.find((c) => c.disponible && c.slug === tema?.calculadora);
    return { params: { slug: entry.id }, props: { entry, relacionadas, calculadora } };
  });
}
const { entry, relacionadas, calculadora } = Astro.props;
const { Content } = await render(entry);
---
<ArticlePage {...entry.data} relacionadas={relacionadas} calculadora={calculadora}><Content /></ArticlePage>
