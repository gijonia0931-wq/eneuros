---
import CalcCard from '../components/CalcCard.astro';
import Base from '../layouts/Base.astro';
import DatoCard from '../components/DatoCard.astro';
import ArticleList from '../components/ArticleList.astro';
import HeroIlustracion from '../components/HeroIlustracion.astro';
import { SITE, CALCULADORAS, DATOS } from '../site';
import { publicados } from '../lib';
const actualidad = (await publicados('actualidad')).slice(0, 5);
const guias = (await publicados('guias')).slice(0, 6);
---
<Base>
  <section class="hero hero-portada">
    <div class="hero-texto">
      <div class="kicker">{SITE.tagline}</div>
      <h1>Tu dinero, con números claros</h1>
      <p class="lead">Calculadoras sencillas, datos oficiales actualizados y noticias económicas explicadas para que sepas cómo afectan a tu bolsillo.</p>
      <div class="hero-botones">
        <a class="btn btn-grande" href="/calculadoras/">🧮 Haz tus cuentas</a>
        <a class="btn btn-grande btn-secondary" href="/datos/">📊 Ver los datos de hoy</a>
      </div>
    </div>
    <HeroIlustracion />
  </section>

  <section class="section">
    <div class="section-head"><h2><span aria-hidden="true">🧮</span> Calculadoras</h2><a class="ver-mas" href="/calculadoras/">Ver todas →</a></div>
    <div class="grid">
      {CALCULADORAS.slice(0, 3).map((c) => <CalcCard calc={c} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2><span aria-hidden="true">📊</span> Datos al día</h2><a class="ver-mas" href="/datos/">Ver todos →</a></div>
    <div class="grid">
      {DATOS.slice(0, 3).map((d) => <DatoCard dato={d} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2><span aria-hidden="true">🗞️</span> Actualidad explicada</h2><a class="ver-mas" href="/actualidad/">Ver todo →</a></div>
    <ArticleList items={actualidad} base="/actualidad/" empty="Pronto publicaremos las primeras noticias explicadas." />
  </section>

  <section class="section">
    <div class="section-head"><h2><span aria-hidden="true">📘</span> Guías</h2><a class="ver-mas" href="/guias/">Ver todas →</a></div>
    <ArticleList items={guias} base="/guias/" empty="Pronto publicaremos las primeras guías." />
  </section>
</Base>
