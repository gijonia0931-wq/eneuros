---
import CalcCard from '../../components/CalcCard.astro';
import Base from '../../layouts/Base.astro';
import { CALCULADORAS } from '../../site';
---
<Base title="Calculadoras" description="Calculadoras de hipoteca, Euríbor, sueldo neto, alquiler, luz e interés compuesto para España.">
  <header class="pagina-cabecera">
    <span class="pagina-icono" aria-hidden="true">🧮</span>
    <div>
      <h1>Calculadoras</h1>
      <p class="lead">Herramientas gratuitas para hacer tus cuentas en segundos, con los datos oficiales más recientes.</p>
    </div>
  </header>
  <div class="grid section">
    {CALCULADORAS.map((c) => <CalcCard calc={c} />)}
  </div>
</Base>
