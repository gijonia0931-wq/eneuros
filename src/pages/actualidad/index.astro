---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { publicados, MAX_NOTICIAS } from '../../lib';
const todas = await publicados('actualidad');
const items = todas.slice(0, MAX_NOTICIAS);
const archivadas = todas.length - items.length;
---
<Base title="Actualidad explicada" description="Las noticias económicas de España explicadas en euros: qué ha pasado y cómo te afecta.">
  <header class="pagina-cabecera">
    <span class="pagina-icono" aria-hidden="true">🗞️</span>
    <div>
      <h1>Actualidad explicada</h1>
      <p class="lead">Las noticias económicas de España explicadas en euros: qué ha pasado y cómo te afecta.</p>
    </div>
  </header>
  <div class="section"><ArticleList items={items} base="/actualidad/" empty="Pronto publicaremos las primeras noticias explicadas." /></div>
  {archivadas > 0 && (
    <p class="section"><a href="/actualidad/archivo/">Ver las {archivadas} noticias anteriores en el archivo</a></p>
  )}
</Base>
