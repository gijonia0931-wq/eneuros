---
import Base from '../layouts/Base.astro';
import ArticleList from './ArticleList.astro';
interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  relacionadas?: { id: string; data: { title: string; description: string; date: Date } }[];
  calculadora?: { slug: string; title: string; desc: string };
}
const { title, description, date, updated, relacionadas = [], calculadora } = Astro.props;
const fmt = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' });
---
<Base title={title} description={description}>
  <article class="prose">
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <p style="color:var(--muted);font-size:.9rem">
      Publicado el <time datetime={date.toISOString()}>{fmt.format(date)}</time>
      {updated && <> · Actualizado el <time datetime={updated.toISOString()}>{fmt.format(updated)}</time></>}
    </p>
    <slot />
  </article>
  {calculadora && (
    <aside class="calc-cta prose">
      <strong>Calculadora {calculadora.title}.</strong> {calculadora.desc}
      <a class="btn" href={`/calculadoras/${calculadora.slug}/`}>Abrir la calculadora</a>
    </aside>
  )}
  {relacionadas.length > 0 && (
    <section class="section prose">
      <h2>Sigue leyendo</h2>
      <ArticleList items={relacionadas} base="/guias/" empty="" />
    </section>
  )}
</Base>
