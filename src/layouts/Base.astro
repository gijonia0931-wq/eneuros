---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE, NAV, LEGAL_NAV, ADSENSE } from '../site';

interface Props {
  title?: string;
  description?: string;
  // Artículos: og:type "article" con sus fechas.
  article?: { published: Date; modified?: Date };
  // Datos estructurados (schema.org) propios de la página, además del sitio y las migas de pan.
  jsonLd?: Record<string, unknown>[];
}
const { title, description = SITE.description, article, jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const ogImage = new URL('/og.png', Astro.site);

// Migas de pan para Google a partir de la URL: Inicio > Sección > Página.
const SECCIONES: Record<string, string> = Object.fromEntries(NAV.map((n) => [n.href.replaceAll('/', ''), n.label]));
const partes = path.split('/').filter(Boolean);
const migas = [{ name: 'Inicio', url: new URL('/', Astro.site).href }];
if (partes[0] && SECCIONES[partes[0]]) migas.push({ name: SECCIONES[partes[0]], url: new URL(`/${partes[0]}/`, Astro.site).href });
if (partes.length > 1 && title) migas.push({ name: title, url: canonical.href });
const datos = [
  ...(path === '/'
    ? [
        { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: new URL('/', Astro.site).href, inLanguage: 'es-ES', description: SITE.description },
        { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href, logo: ogImage.href },
      ]
    : []),
  ...(migas.length > 1
    ? [{
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: migas.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.name, item: m.url })),
      }]
    : []),
  ...jsonLd,
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Google Consent Mode v2: nada de publicidad hasta que la persona elige en el aviso de cookies.
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {datos.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    {ADSENSE.client && (
      <>
        <meta name="google-adsense-account" content={ADSENSE.client} />
        <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`} crossorigin="anonymous"></script>
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">en<span>euros</span></a>
        <nav class="nav" aria-label="Principal">
          {NAV.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div><strong>eneuros</strong> · {SITE.tagline}</div>
        <nav class="footer-links" aria-label="Información">
          {LEGAL_NAV.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/cookies/" data-cookie-settings>Configurar cookies</a>
        </nav>
        <div>© {new Date().getFullYear()} eneuros.es</div>
      </div>
    </footer>
    {ADSENSE.client ? (
      <script is:inline>
        // Con AdSense, el consentimiento lo gestiona el mensaje de Google (Privacidad y mensajes, IAB TCF).
        // "Configurar cookies" vuelve a abrir ese mensaje.
        document.querySelectorAll('[data-cookie-settings]').forEach(function (el) {
          el.addEventListener('click', function (e) {
            e.preventDefault();
            window.googlefc = window.googlefc || {};
            window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
            window.googlefc.callbackQueue.push(function () { window.googlefc.showRevocationMessage(); });
          });
        });
      </script>
    ) : (
      <CookieBanner />
    )}
  </body>
</html>
